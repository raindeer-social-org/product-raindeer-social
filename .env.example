# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- App ---
ENVIRONMENT=development
SECRET_KEY=change-me
# Fernet key (32 url-safe base64-encoded bytes) encrypting OAuth tokens at
# rest. Generate your own with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Database (Postgres + pgvector) ---
DATABASE_URL=postgresql://localhost:5432/raindeer

# --- Redis / job queue ---
REDIS_URL=redis://localhost:6379/0

# --- LLM providers (fill in at least one) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Search provider (used by the Research Engine, added in a later issue) ---
TAVILY_API_KEY=

# --- Provider selection (packages/integrations/registry.py) ---
SEARCH_PROVIDER=tavily
LLM_PROVIDER=openrouter
STORAGE_PROVIDER=supabase
EMBEDDING_PROVIDER=openai

# Default model every agent passes to the LLM provider (see
# packages/integrations/llm/). "openrouter/free" is OpenRouter's free-
# models router — no cost, no separate model ID to keep up to date — so
# local dev and early agents run for free out of the box. Swap for a paid
# slug (e.g. "anthropic/claude-sonnet-4.5") once quality/latency needs
# outgrow the free tier; nothing else in the code has to change.
LLM_DEFAULT_MODEL=openrouter/free

# --- Media storage (brand logos, generated images/video) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=brand-assets

# --- Error tracking (optional locally — leave blank to disable Sentry) ---
SENTRY_DSN=

# --- Social OAuth (brand SocialAccount connections) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/oauth/linkedin/callback

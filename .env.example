# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- App ---
ENVIRONMENT=development
SECRET_KEY=change-me
# Fernet key (32 url-safe base64-encoded bytes) encrypting OAuth tokens at
# rest. Generate your own with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Database (Postgres + pgvector) ---
DATABASE_URL=postgresql://localhost:5432/raindeer

# --- Redis / job queue ---
REDIS_URL=redis://localhost:6379/0

# --- LLM providers (fill in at least one) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Search provider (used by the Research Engine, added in a later issue) ---
TAVILY_API_KEY=

# --- Provider selection (packages/integrations/registry.py) ---
SEARCH_PROVIDER=tavily
LLM_PROVIDER=openrouter
STORAGE_PROVIDER=supabase
EMBEDDING_PROVIDER=openai

# --- Media storage (brand logos, generated images/video) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=brand-assets

# --- Error tracking (optional locally — leave blank to disable Sentry) ---
SENTRY_DSN=

# --- Status notifications (email/Slack, Issue #32) ---
# Generic SMTP (any transactional-email provider that exposes SMTP
# credentials). Leave SMTP_HOST blank to disable email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=notifications@raindeer.social
# Slack incoming-webhook URL. Leave blank to disable Slack notifications.
SLACK_WEBHOOK_URL=

# --- Social OAuth (brand SocialAccount connections) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/oauth/linkedin/callback

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/oauth/x/callback
# App-level key, reserved for X's v1.1 media/upload endpoint (OAuth 1.0a,
# not the OAuth2 flow used for publishing) — not required today.
X_API_KEY=

# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- App ---
ENVIRONMENT=development
SECRET_KEY=change-me

# --- Database (Postgres + pgvector) ---
DATABASE_URL=postgresql://localhost:5432/raindeer

# --- Redis / job queue ---
REDIS_URL=redis://localhost:6379/0

# --- LLM providers (fill in at least one) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Search provider (used by the Research Engine, added in a later issue) ---
TAVILY_API_KEY=

# --- Provider selection (packages/integrations/registry.py) ---
SEARCH_PROVIDER=tavily
LLM_PROVIDER=openrouter

# --- Error tracking (optional locally — leave blank to disable Sentry) ---
SENTRY_DSN=
